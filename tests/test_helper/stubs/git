#!/usr/bin/env bash
echo "git $*" >> "${MACUP_CALL_LOG:-/dev/null}"

subcommand="$1"
if [ "$1" = "-C" ]; then
  subcommand="$3"
fi

case "$subcommand" in
  clone)
    if [ "${GIT_CLONE_EXIT:-0}" != "0" ]; then
      exit "$GIT_CLONE_EXIT"
    fi
    target="${*: -1}"
    mkdir -p "$target/.git"
    exit 0
    ;;
  pull)
    echo "Already up to date."
    exit 0
    ;;
  config)
    shift
    file=""
    if [ "$1" = "-f" ]; then
      shift
      file="$1"
      shift
    fi
    if [ "$1" = "--get" ]; then
      key="$2"
      line="$(grep "^$key=" "$file" 2>/dev/null | head -1 || true)"
      if [ -z "$line" ]; then
        exit 1
      fi
      echo "${line#*=}"
      exit 0
    else
      key="$1"
      value="$2"
      if ! touch "$file" 2>/dev/null; then
        exit 1
      fi
      grep -v "^$key=" "$file" > "$file.tmp" 2>/dev/null || true
      mv "$file.tmp" "$file" 2>/dev/null || true
      echo "$key=$value" >> "$file"
      exit 0
    fi
    ;;
  *)
    exit 0
    ;;
esac
